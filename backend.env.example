# 黄金会议实时后台配置示例
#
# 目标：
# 1. 使用真实授权行情源更新 XAUUSD 价格。
# 2. 使用金十授权接口获取实时快讯/经济数据。
# 3. 后端输出 /api/realtime-snapshot 给网页做自动分析。

# 优先方案 A：自定义 XAUUSD 行情 API
# 返回 JSON 示例：
# {"price": 4439.52, "bid": 4439.08, "ask": 4440.64, "time": "2026-06-07T09:00:00Z"}
XAUUSD_QUOTE_API_URL=
XAUUSD_QUOTE_API_KEY=
XAUUSD_QUOTE_API_KEY_HEADER=Authorization
XAUUSD_QUOTE_PRICE_PATH=price
XAUUSD_QUOTE_BID_PATH=bid
XAUUSD_QUOTE_ASK_PATH=ask
XAUUSD_QUOTE_TIME_PATH=time
XAUUSD_QUOTE_SOURCE_NAME=Authorized XAUUSD API

# 优先方案 B：OANDA 官方 API
# 注意：需要你自己的 OANDA API Key 和账户 ID。
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# 金十授权接口
# 返回 JSON 示例：
# {"data":[{"time":"09:30","title":"美国数据...", "impact":"利多黄金", "analysis":"..."}]}
JIN10_API_URL=
JIN10_API_KEY=
JIN10_API_KEY_HEADER=Authorization
JIN10_ITEMS_PATH=data
